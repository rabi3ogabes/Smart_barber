{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "tokens": "node scripts/build-tokens.mjs",
        "predev": "npm run tokens",
        "dev": "vite",
        "prebuild": "npm run tokens",
        "build": "vue-tsc --noEmit && vite build",
        "lint": "eslint resources/js && node scripts/check-rtl.mjs && node scripts/check-i18n.mjs",
        "lint:rtl": "node scripts/check-rtl.mjs",
        "lint:i18n": "node scripts/check-i18n.mjs",
        "format": "prettier --write resources/js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.11",
        "@vitejs/plugin-vue": "^6.0.11",
        "concurrently": "^10.0.3",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.0.0",
        "vue-eslint-parser": "^10.4.2",
        "vue-tsc": "^3.3.14"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource/fraunces": "^5.3.0",
        "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@inertiajs/vue3": "^3.11.0",
        "cropperjs": "1.6.2",
        "lucide-vue-next": "^1.0.0",
        "reka-ui": "^2.11.0",
        "vue": "^3.5.46",
        "vue-i18n": "^11.4.24"
    }
}
