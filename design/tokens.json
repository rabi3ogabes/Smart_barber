{
  "$description": "Single source of design tokens (docs/architecture/design-system.md). backend/scripts/build-tokens.mjs generates the dashboard CSS; Phase 1b generates sb_ui Dart from the same file. Never hard-code these values in screens.",
  "color": {
    "background":        { "light": "#F7F5F1", "dark": "#0E0E0F" },
    "surface":           { "light": "#FFFFFF", "dark": "#17171A" },
    "surface-elevated":  { "light": "#FFFFFF", "dark": "#1F1F23" },
    "surface-muted":     { "light": "#EFEBE4", "dark": "#141416" },
    "text-primary":      { "light": "#141414", "dark": "#F2EFEA" },
    "text-secondary":    { "light": "#6B6760", "dark": "#A39E95" },
    "border":            { "light": "#E6E1D8", "dark": "#2A2A2F" },
    "primary":           { "light": "#1A1A1C", "dark": "#F2EFEA" },
    "on-primary":        { "light": "#F7F5F1", "dark": "#141414" },
    "accent":            { "light": "#B8975A", "dark": "#C9A96E" },
    "accent-soft":       { "light": "#F3ECDF", "dark": "#2A241A" },
    "success":           { "light": "#2F7D5B", "dark": "#5DBB8E" },
    "success-soft":      { "light": "#E6F2EC", "dark": "#15281F" },
    "warning":           { "light": "#B7791F", "dark": "#E0A54A" },
    "warning-soft":      { "light": "#F8EEDD", "dark": "#2B2112" },
    "error":             { "light": "#B42318", "dark": "#F0705F" },
    "error-soft":        { "light": "#FBE9E7", "dark": "#2E1513" },
    "info":              { "light": "#2E5E8C", "dark": "#7EA9D6" },
    "info-soft":         { "light": "#E7EEF5", "dark": "#141F2B" },
    "disabled":          { "light": "#CFCAC1", "dark": "#3A3A40" },
    "overlay":           { "light": "rgba(20, 20, 20, 0.45)", "dark": "rgba(0, 0, 0, 0.6)" }
  },
  "font": {
    "sans-latin": "Inter",
    "display-latin": "Fraunces",
    "sans-arabic": "IBM Plex Sans Arabic"
  },
  "type": {
    "display": { "size": 40, "line": 48, "weight": 600 },
    "h1":      { "size": 32, "line": 40, "weight": 600 },
    "h2":      { "size": 24, "line": 32, "weight": 600 },
    "h3":      { "size": 20, "line": 28, "weight": 600 },
    "h4":      { "size": 17, "line": 24, "weight": 600 },
    "body":    { "size": 15, "line": 22, "weight": 400 },
    "label":   { "size": 13, "line": 18, "weight": 500 },
    "caption": { "size": 12, "line": 16, "weight": 400 },
    "button":  { "size": 15, "line": 20, "weight": 600 }
  },
  "radius": { "input": 8, "card": 12, "sheet": 20, "pill": 999 },
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "motion": { "fast": 150, "base": 200, "slow": 250, "easing": "cubic-bezier(0.2, 0, 0, 1)" },
  "shadow": {
    "sm": { "light": "0 1px 2px rgba(20,20,20,0.06), 0 1px 1px rgba(20,20,20,0.04)", "dark": "0 1px 2px rgba(0,0,0,0.5)" },
    "md": { "light": "0 8px 24px rgba(20,20,20,0.08), 0 2px 6px rgba(20,20,20,0.05)", "dark": "0 8px 24px rgba(0,0,0,0.55)" }
  },
  "layout": { "sidebar-expanded": 264, "sidebar-collapsed": 76, "header-height": 64, "touch-target": 48 }
}
